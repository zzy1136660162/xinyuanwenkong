MQTT_BROKER_URL=mqtt://127.0.0.1:1883
DEVICE_SN=DN4G35AJ0123
DEVICE_IMEI=864865082580458
DEVICE_ICCID=89860479102590023261
DEV_ADDR=1

# 当前 docker-compose 中 EMQX 未启用 MQTT 客户端认证，留空即可。
# 这里不是 EMQX Dashboard 的 admin/gesoft9919 登录账号。
MQTT_USERNAME=
MQTT_PASSWORD=

# true 时启动后先发布 IMEI/getsn，等待平台通过 IMEI/setsn 下发 SN。
PROVISION_ON_START=false

# true 时设备上报会携带 MQTT retain 标志，便于在 EMQX Dashboard 的 Retained Messages 页面查看最后一条保留消息。
RETAIN_MESSAGES=false

# 真实设备可设置为 1800000，即 30 分钟。
FULL_REPORT_INTERVAL_MS=1800000

# 模拟器为了方便观察变量变化，默认 5 秒检查一次。
DELTA_REPORT_INTERVAL_MS=5000
